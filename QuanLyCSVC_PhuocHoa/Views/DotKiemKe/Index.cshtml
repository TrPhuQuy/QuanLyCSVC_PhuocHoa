@model IEnumerable<DotKiemKe>
@{
    ViewData["Title"] = "Quản lý Đợt Kiểm kê";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clipboard-check text-info"></i> Kiểm kê Tài sản</h2>
        <p class="text-muted mb-0">Theo dõi các đợt kiểm kê thiết bị định kỳ của nhà trường</p>
    </div>
    <a asp-action="Create" class="btn btn-info text-white"><i class="bi bi-plus-lg"></i> Tạo đợt kiểm kê</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="trangThai" class="form-select">
            <option value="">-- Trạng thái --</option>
            @foreach (var tt in ViewBag.TrangThais)
            {
                <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@tt</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="namHoc" class="form-select">
            <option value="">-- Năm học --</option>
            @foreach (var nh in ViewBag.NamHocs)
            {
                <option value="@nh" selected="@(ViewBag.NamHoc == nh)">@nh</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đợt</th>
                    <th>Loại kiểm kê</th>
                    <th>Năm học</th>
                    <th>Thời gian</th>
                    <th>Người chủ trì</th>
                    <th>Số TB kiểm</th>
                    <th>Trạng thái</th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 text-muted">Chưa có đợt kiểm kê nào.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var badgeColor = item.TrangThai == "Hoàn thành" ? "success" : "primary";
                        <tr>
                            <td><strong>@item.MaDotKiemKe</strong></td>
                            <td>@item.LoaiKiemKe</td>
                            <td><span class="badge bg-secondary">@item.NamHoc</span></td>
                            <td>
                                @item.NgayBatDau.ToString("dd/MM/yyyy") → @item.NgayKetThuc.ToString("dd/MM/yyyy")
                            </td>
                            <td>@item.NguoiChuTri?.HoTen</td>
                            <td><span class="badge bg-info text-dark">@item.ChiTietKiemKe.Count</span></td>
                            <td><span class="badge bg-@badgeColor">@item.TrangThai</span></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
