@model DotKiemKe
@{
    ViewData["Title"] = "Tạo đợt kiểm kê mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clipboard-plus text-info"></i> @ViewData["Title"]</h2>
        <p class="text-muted mb-0">Thiết lập thông tin đợt kiểm kê thiết bị, cơ sở vật chất mới</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaDotKiemKe" class="form-label fw-bold">Mã đợt kiểm kê <span class="text-danger">*</span></label>
                    <input asp-for="MaDotKiemKe" class="form-control" placeholder="VD: KK-20260720" />
                    <span asp-validation-for="MaDotKiemKe" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="LoaiKiemKe" class="form-label fw-bold">Loại kiểm kê <span class="text-danger">*</span></label>
                    <select asp-for="LoaiKiemKe" class="form-select">
                        @foreach (var loai in ViewBag.LoaiKiemKes)
                        {
                            <option value="@loai">@loai</option>
                        }
                    </select>
                    <span asp-validation-for="LoaiKiemKe" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HocKy" class="form-label fw-bold">Học kỳ</label>
                    <select asp-for="HocKy" class="form-select">
                        <option value="">-- Chọn học kỳ (Tùy chọn) --</option>
                        <option value="1">Học kỳ I</option>
                        <option value="2">Học kỳ II</option>
                    </select>
                    <span asp-validation-for="HocKy" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NamHoc" class="form-label fw-bold">Năm học <span class="text-danger">*</span></label>
                    <input asp-for="NamHoc" class="form-control" placeholder="VD: 2025-2026" />
                    <span asp-validation-for="NamHoc" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NgayBatDau" class="form-label fw-bold">Ngày bắt đầu <span class="text-danger">*</span></label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NgayKetThuc" class="form-label fw-bold">Ngày kết thúc dự kiến <span class="text-danger">*</span></label>
                    <input asp-for="NgayKetThuc" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="NguoiChuTriId" class="form-label fw-bold">Người chủ trì kiểm kê <span class="text-danger">*</span></label>
                    <select asp-for="NguoiChuTriId" class="form-select" asp-items="ViewBag.NguoiChuTriId">
                        <option value="">-- Chọn giáo viên / nhân viên chủ trì --</option>
                    </select>
                    <span asp-validation-for="NguoiChuTriId" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="TrangThai" />
            </div>

            <div class="mt-4 border-top pt-3">
                <button type="submit" class="btn btn-info text-white"><i class="bi bi-save"></i> Bắt đầu kiểm kê</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
