@model PaginatedList<LichSuHoatDong>
@{
    ViewData["Title"] = "Nhật ký hoạt động";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clock-history text-secondary"></i> Nhật ký hoạt động hệ thống</h2>
        <p class="text-muted mb-0">Theo dõi hoạt động, thao tác của người dùng trên hệ thống</p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Từ khóa tìm kiếm</label>
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo email, tên, hành động..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Đối tượng tác động</label>
                <select name="doiTuong" class="form-select">
                    <option value="">-- Tất cả đối tượng --</option>
                    @foreach (var dt in ViewBag.DoiTuongs)
                    {
                        <option value="@dt" selected="@(ViewBag.DoiTuong == dt)">@dt</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Từ ngày</label>
                <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Đến ngày</label>
                <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Lọc nhật ký</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 180px;">Thời gian</th>
                    <th>Người thực hiện</th>
                    <th>Đối tượng</th>
                    <th>Hành động thực hiện</th>
                    <th>Địa chỉ IP</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Không tìm thấy nhật ký hoạt động nào phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        var badgeColor = "secondary";
                        var action = log.HanhDong.ToLower();
                        if (action.Contains("thêm") || action.Contains("tạo")) badgeColor = "success";
                        else if (action.Contains("cập nhật") || action.Contains("sửa")) badgeColor = "warning text-dark";
                        else if (action.Contains("xóa")) badgeColor = "danger";
                        else if (action.Contains("duyệt") || action.Contains("chấp nhận")) badgeColor = "info text-dark";
                        else if (action.Contains("từ chối")) badgeColor = "dark";

                        <tr>
                            <td class="font-monospace">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <div><strong>@(log.User?.NhanVien?.HoTen ?? "Tài khoản hệ thống")</strong></div>
                                <small class="text-muted">@log.User?.Email</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@log.DoiTuong</span>
                            </td>
                            <td>
                                <span class="badge bg-@badgeColor me-2">@log.HanhDong.Split(':')[0]</span>
                                @if (log.HanhDong.Contains(":"))
                                {
                                    <span>@log.HanhDong.Substring(log.HanhDong.IndexOf(":") + 1)</span>
                                }
                            </td>
                            <td class="font-monospace text-muted">@(log.DiaChiIP ?? "N/A")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
