@model Phong
@{
    ViewData["Title"] = "Chi tiết phòng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-door-open text-primary"></i> @Model.TenPhong <small class="text-muted">(@Model.MaPhong)</small></h2>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#qrRoomModal">
            <i class="bi bi-qr-code"></i> Mã QR & Tem phòng
        </button>
        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><strong>Thông tin phòng</strong></div>
            <div class="card-body">
                <p><strong>Loại phòng:</strong> @(Model.LoaiPhong?.TenLoaiPhong ?? "-")</p>
                <p><strong>Vị trí:</strong> @(Model.ViTri ?? "-")</p>
                <p><strong>Người phụ trách:</strong> @(Model.NguoiPhuTrach?.HoTen ?? "-")</p>
                <p><strong>Sức chứa:</strong> @(Model.SucChua?.ToString() ?? "-")</p>
                <p><strong>Trạng thái:</strong> <span class="badge bg-success">@Model.TrangThai</span></p>
                <hr class="my-2" />
                <p><strong>Tổng số thiết bị:</strong> <span class="badge bg-primary fs-6">@(Model.ThietBi?.Where(t => !t.IsDeleted).Sum(t => t.SoLuong) ?? 0)</span></p>
                <p><strong>Tổng giá trị CSVC:</strong> <span class="fw-bold text-success fs-6">@(Model.ThietBi?.Where(t => !t.IsDeleted && t.GiaMua.HasValue).Sum(t => (t.GiaMua ?? 0) * t.SoLuong).ToString("N0") ?? "0") đ</span></p>
                <p class="mb-0"><strong>Ghi chú:</strong> @(Model.GhiChu ?? "-")</p>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                <strong><i class="bi bi-pc-display"></i> Thiết bị trong phòng (@(Model.ThietBi?.Count(t => !t.IsDeleted) ?? 0) loại &bull; @(Model.ThietBi?.Where(t => !t.IsDeleted).Sum(t => t.SoLuong) ?? 0) hiện vật)</strong>

                @if (Model.ThietBi != null && Model.ThietBi.Any(t => !t.IsDeleted))
                {
                    <a asp-controller="ThietBi" asp-action="PrintLabels" asp-route-phongId="@Model.Id" target="_blank" class="btn btn-sm btn-outline-dark">
                        <i class="bi bi-printer"></i> In tem tất cả thiết bị
                    </a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="table-light"><tr><th>Mã TB</th><th>Tên</th><th>SL</th><th>Tình trạng</th><th></th></tr></thead>
                    <tbody>
                        @if (Model.ThietBi != null && Model.ThietBi.Any(t => !t.IsDeleted))
                        {
                            @foreach (var tb in Model.ThietBi.Where(t => !t.IsDeleted))
                            {
                                <tr>
                                    <td><strong>@tb.MaTb</strong></td>
                                    <td>@tb.TenTb</td>
                                    <td>@tb.SoLuong @tb.DonViTinh</td>
                                    <td><span class="badge bg-@EnumHelper.BadgeTinhTrang(tb.TinhTrang)">@EnumHelper.TenTinhTrang(tb.TinhTrang)</span></td>
                                    <td class="text-end text-nowrap">
                                        <a asp-controller="ThietBi" asp-action="Details" asp-route-id="@tb.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                        <a asp-controller="PhieuBaoTri" asp-action="Create" asp-route-thietBiId="@tb.Id" class="btn btn-sm btn-outline-warning text-dark" title="Báo hỏng thiết bị này"><i class="bi bi-exclamation-triangle"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">Chưa có thiết bị nào trong phòng này</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Mã QR & Tem phòng -->
<div class="modal fade" id="qrRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title"><i class="bi bi-qr-code"></i> Tem phòng học & Mã QR</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div id="roomStickerPrintArea" class="d-inline-block text-start">
                    <div class="asset-sticker p-3 border border-2 border-dark rounded bg-white shadow-sm" style="max-width: 420px; font-family: 'Inter', sans-serif;">
                        <div class="text-center border-bottom pb-2 mb-2">
                            <div class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: #1e3a8a;">TRƯỜNG THCS PHƯỚC HÒA</div>
                            <div class="fw-bold text-primary" style="font-size: 14px;">BIỂN QUẢN LÝ PHÒNG HỌC</div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-grow-1" style="font-size: 12px; line-height: 1.5;">
                                <div class="mb-1"><strong>Mã phòng:</strong> <span class="badge bg-primary">@Model.MaPhong</span></div>
                                <div class="mb-1"><strong>Tên phòng:</strong> <span class="fw-bold fs-6">@Model.TenPhong</span></div>
                                <div class="mb-1"><strong>Loại:</strong> @(Model.LoaiPhong?.TenLoaiPhong ?? "-")</div>
                                <div class="mb-1"><strong>Phụ trách:</strong> @(Model.NguoiPhuTrach?.HoTen ?? "-")</div>
                                <div><strong>Vị trí:</strong> @(Model.ViTri ?? "-")</div>
                            </div>
                            <div class="text-center flex-shrink-0">
                                <div id="roomQrcode" class="d-inline-block p-1 border rounded bg-white"></div>
                                <div class="text-muted" style="font-size: 9px; margin-top: 2px;">SCAN TO VIEW CSVC</div>
                            </div>
                        </div>
                        <div class="text-center border-top pt-1 mt-2 text-muted" style="font-size: 9px;">
                            Quét mã QR để xem danh sách toàn bộ thiết bị trong phòng
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="printRoomSticker()">
                    <i class="bi bi-printer"></i> In tem phòng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        const roomQrUrl = window.location.href;
        document.addEventListener("DOMContentLoaded", function () {
            new QRCode(document.getElementById("roomQrcode"), {
                text: roomQrUrl,
                width: 95,
                height: 95,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        });

        function printRoomSticker() {
            const content = document.getElementById("roomStickerPrintArea").innerHTML;
            const printWin = window.open("", "_blank", "width=500,height=350");
            printWin.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>In biển phòng - @Model.MaPhong</title>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
                    <style>
                        body { margin: 15px; font-family: Arial, sans-serif; }
                        .asset-sticker { border: 2px solid #000 !important; width: 400px; }
                        @@media print {
                            body { margin: 0; }
                            .asset-sticker { box-shadow: none !important; border: 1.5px solid #000 !important; }
                        }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${content}
                </body>
                </html>
            `);
            printWin.document.close();
        }
    </script>
}
