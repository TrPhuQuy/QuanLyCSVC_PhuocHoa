@model IEnumerable<Phong>
@{
    ViewData["Title"] = "Quản lý phòng";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-door-open text-primary"></i> Danh sách phòng</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm phòng</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo mã, tên phòng..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Tìm kiếm</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phòng</th>
                    <th>Tên phòng</th>
                    <th>Loại phòng</th>
                    <th>Vị trí</th>
                    <th>Người phụ trách</th>
                    <th>Sức chứa</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.MaPhong</strong></td>
                        <td>@item.TenPhong</td>
                        <td>@(item.LoaiPhong?.TenLoaiPhong ?? "-")</td>
                        <td>@item.ViTri</td>
                        <td>@(item.NguoiPhuTrach?.HoTen ?? "-")</td>
                        <td>@(item.SucChua?.ToString() ?? "-")</td>
                        <td>
                            @{
                                var badgeClass = item.TrangThai switch
                                {
                                    "Đang sử dụng" => "success",
                                    "Đang sửa chữa" => "warning",
                                    "Tạm đóng cửa" => "danger",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@badgeClass">@item.TrangThai</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa phòng này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
