@model ThietBi
@{
    ViewData["Title"] = "Chi tiết thiết bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-pc-display text-primary"></i> @Model.TenTb</h2>
        <p class="text-muted mb-0">Mã thiết bị: <strong>@Model.MaTb</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#qrModal">
            <i class="bi bi-qr-code"></i> Mã QR & In tem
        </button>
        <a asp-controller="PhieuBaoTri" asp-action="Create" asp-route-thietBiId="@Model.Id" class="btn btn-warning text-dark">
            <i class="bi bi-exclamation-triangle"></i> Báo hỏng
        </a>
        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Sửa</a>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-image"></i> Hình ảnh thiết bị</h5>
            </div>
            <div class="card-body text-center bg-light py-4">
                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <img src="@Model.HinhAnh" class="img-fluid rounded shadow-sm max-height-300" style="max-height: 250px; object-fit: contain;" alt="@Model.TenTb" />
                }
                else
                {
                    <div class="py-5 text-muted">
                        <i class="bi bi-image-alt display-1"></i>
                        <p class="mt-2 mb-0">Không có hình ảnh</p>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h5 class="card-title mb-0 fw-semibold"><i class="bi bi-tag"></i> Trạng thái & Vị trí</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Tình trạng:</span>
                        <span class="badge bg-@EnumHelper.BadgeTinhTrang(Model.TinhTrang) fs-6">@EnumHelper.TenTinhTrang(Model.TinhTrang)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Phòng quản lý:</span>
                        <a asp-controller="Phong" asp-action="Details" asp-route-id="@Model.PhongId" class="fw-bold text-decoration-none">
                            <i class="bi bi-door-open"></i> @Model.Phong?.TenPhong
                        </a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Vị trí sử dụng:</span>
                        <span class="fw-semibold">@(Model.ViTriSuDung ?? "-")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Bộ môn quản lý:</span>
                        <span class="fw-semibold">@(Model.BoMon?.TenBoMon ?? "-")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-info-circle text-primary"></i> Thông tin chi tiết</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Tên thiết bị</small>
                        <span class="fs-5 fw-bold text-dark">@Model.TenTb</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Phân loại</small>
                        <span class="fs-5 fw-semibold text-primary">@Model.LoaiThietBi?.TenLoaiTB</span>
                    </div>

                    <hr class="text-muted my-2" />

                    <div class="col-sm-4">
                        <small class="text-muted d-block">Số lượng</small>
                        <span class="fs-5 fw-semibold">@Model.SoLuong @Model.DonViTinh</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Đơn giá mua</small>
                        <span class="fs-5 fw-semibold text-success">@(Model.GiaMua?.ToString("N0") ?? "-") đ</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Tổng trị giá</small>
                        <span class="fs-5 fw-bold text-success">@((Model.GiaMua * Model.SoLuong)?.ToString("N0") ?? "-") đ</span>
                    </div>

                    <hr class="text-muted my-2" />

                    <div class="col-sm-4">
                        <small class="text-muted d-block">Hãng sản xuất</small>
                        <span class="fw-semibold">@(Model.HangSanXuat ?? "-")</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Năm sản xuất</small>
                        <span class="fw-semibold">@(Model.NamSanXuat?.ToString() ?? "-")</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Ngày mua</small>
                        <span class="fw-semibold">@(Model.NgayMua?.ToString("dd/MM/yyyy") ?? "-")</span>
                    </div>

                    <hr class="text-muted my-2" />

                    <div class="col-sm-6">
                        <small class="text-muted d-block">Nhà cung cấp</small>
                        <span class="fw-semibold">@(Model.NhaCungCap?.TenNCC ?? "-")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Ngày đưa vào quản lý</small>
                        <span class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="col-12 mt-3">
                        <small class="text-muted d-block">Ghi chú</small>
                        <div class="bg-light p-3 rounded border text-secondary" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú nào." : Model.GhiChu)</div>
                    </div>
                </div>
            </div>
        </div>

        @{
            var haoMon = EnumHelper.TinhHaoMon(Model.GiaMua, Model.SoLuong, Model.NamSanXuat, Model.NgayMua, Model.CreatedAt, Model.LoaiThietBi?.TenLoaiTB);
        }
        <!-- Khối Theo dõi Hao mòn & Khấu hao tài sản (Thông tư 45/2018/TT-BTC & TT 23/2023/TT-BTC) -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-semibold text-dark">
                    <i class="bi bi-calculator text-success"></i> Theo dõi Hao mòn &amp; Giá trị sổ sách
                </h5>
                <span class="badge bg-light text-muted border">TT 45/2018/TT-BTC &amp; TT 23/2023/TT-BTC</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Nguyên giá tài sản</small>
                        <span class="fs-5 fw-bold text-dark">@haoMon.NguyenGia.ToString("N0") đ</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Hao mòn lũy kế (@haoMon.TyLeHaoMonLuyKe%)</small>
                        <span class="fs-5 fw-bold text-danger">@haoMon.GiaTriHaoMonLuyKe.ToString("N0") đ</span>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Giá trị còn lại</small>
                        <span class="fs-5 fw-bold text-success">@haoMon.GiaTriConLai.ToString("N0") đ</span>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>Tiến độ hao mòn tài sản (Năm đưa vào SD: <strong>@haoMon.NamDuaVaoSuDung</strong> - Đã qua: <strong>@haoMon.SoNamSuDung năm</strong>)</span>
                        <span class="fw-bold">@haoMon.TyLeHaoMonLuyKe% (Định mức: @haoMon.TyLeHaoMonNam%/năm)</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar @(haoMon.DaHetKhauHao ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @haoMon.TyLeHaoMonLuyKe%;" aria-valuenow="@haoMon.TyLeHaoMonLuyKe" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="mt-3 p-2 rounded bg-light border small d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-info-circle text-primary me-1"></i>
                        <strong>Trạng thái kế toán:</strong>
                        @if (haoMon.DaHetKhauHao)
                        {
                            <span class="text-danger fw-semibold">Tài sản đã hết thời gian tính hao mòn (100%), tiếp tục theo dõi sử dụng đến khi thanh lý.</span>
                        }
                        else
                        {
                            <span class="text-success fw-semibold">Tài sản đang trong thời gian trích tính hao mòn theo quy định hiện hành của Bộ Tài chính.</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal Mã QR & In tem kiểm kê tài sản -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title" id="qrModalLabel"><i class="bi bi-qr-code"></i> Tem tài sản & Mã QR</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <!-- Vùng in tem nhãn (Sticker Area) -->
                <div id="stickerPrintArea" class="d-inline-block text-start">
                    <div class="asset-sticker p-3 border border-2 border-dark rounded bg-white shadow-sm" style="max-width: 400px; font-family: 'Inter', sans-serif;">
                        <div class="text-center border-bottom pb-2 mb-2">
                            <div class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px; color: #1e3a8a;">TRƯỜNG THCS PHƯỚC HÒA</div>
                            <div class="fw-bold text-danger" style="font-size: 13px;">TEM QUẢN LÝ TÀI SẢN</div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-grow-1" style="font-size: 12px; line-height: 1.4;">
                                <div class="mb-1"><strong>Mã TB:</strong> <span class="badge bg-dark">@Model.MaTb</span></div>
                                <div class="mb-1 text-truncate" style="max-width: 220px;" title="@Model.TenTb"><strong>Tên:</strong> @Model.TenTb</div>
                                <div class="mb-1"><strong>Phòng:</strong> @(Model.Phong?.TenPhong ?? "-")</div>
                                <div class="mb-1"><strong>Bộ môn:</strong> @(Model.BoMon?.TenBoMon ?? "Chung")</div>
                                <div><strong>Năm SD:</strong> @(Model.NamSanXuat?.ToString() ?? Model.NgayMua?.Year.ToString() ?? DateTime.Now.Year.ToString())</div>
                            </div>
                            <div class="text-center flex-shrink-0">
                                <div id="qrcode" class="d-inline-block p-1 border rounded bg-white"></div>
                                <div class="text-muted" style="font-size: 9px; margin-top: 2px;">SCAN ME</div>
                            </div>
                        </div>
                        <div class="text-center border-top pt-1 mt-2 text-muted" style="font-size: 9px;">
                            Hệ thống Quản lý CSVC THCS Phước Hòa
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-muted small">
                    <i class="bi bi-info-circle"></i> Tem được thiết kế chuẩn kích thước để in dán trực tiếp lên thiết bị/bàn ghế.
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-outline-primary" onclick="downloadQR()">
                    <i class="bi bi-download"></i> Tải ảnh QR
                </button>
                <button type="button" class="btn btn-primary" onclick="printSticker()">
                    <i class="bi bi-printer"></i> In tem nhãn
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        // Tạo mã QR trỏ thẳng đến trang chi tiết thiết bị này
        const qrUrl = window.location.href;
        let qrCodeInstance = null;

        document.addEventListener("DOMContentLoaded", function () {
            qrCodeInstance = new QRCode(document.getElementById("qrcode"), {
                text: qrUrl,
                width: 95,
                height: 95,
                colorDark: "#000000",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        });

        // Hàm in tem nhãn riêng biệt
        function printSticker() {
            const content = document.getElementById("stickerPrintArea").innerHTML;
            const printWin = window.open("", "_blank", "width=500,height=350");
            printWin.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>In tem tài sản - @Model.MaTb</title>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
                    <style>
                        body { margin: 15px; font-family: Arial, sans-serif; }
                        .asset-sticker { border: 2px solid #000 !important; width: 380px; }
                        @@media print {
                            body { margin: 0; }
                            .asset-sticker { box-shadow: none !important; border: 1.5px solid #000 !important; }
                        }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${content}
                </body>
                </html>
            `);
            printWin.document.close();
        }

        // Tải ảnh QR dưới dạng PNG
        function downloadQR() {
            const img = document.querySelector("#qrcode img");
            if (img && img.src) {
                const a = document.createElement("a");
                a.href = img.src;
                a.download = "QR_@Model.MaTb" + ".png";
                a.click();
            } else {
                alert("Đang tạo mã QR, vui lòng thử lại sau giây lát.");
            }
        }
    </script>
}
