@model PaginatedList<ThietBi>
@{
    ViewData["Title"] = "Quản lý thiết bị";
}

<div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="d-flex align-items-center gap-2">
            <i class="bi bi-pc-display text-primary"></i>
            <span>Danh mục Thiết bị</span>
            <span class="badge bg-primary fs-6 fw-bold">@Model.TotalItems</span>
        </h2>
        <p>Quản lý toàn bộ danh sách thiết bị dạy học, tài sản cơ sở vật chất theo phòng và tổ bộ môn</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#qrScannerModal">
            <i class="bi bi-qr-code-scan"></i> Quét QR
        </button>
        <a asp-action="PrintLabels"
           asp-route-search="@ViewBag.Search"
           asp-route-loaiId="@Context.Request.Query["loaiId"]"
           asp-route-phongId="@Context.Request.Query["phongId"]"
           asp-route-tinhTrang="@Context.Request.Query["tinhTrang"]"
           target="_blank"
           class="btn btn-outline-dark">
            <i class="bi bi-printer"></i> In tem nhãn
        </a>
        <a asp-action="ExportExcel"
           asp-route-search="@ViewBag.Search"
           asp-route-loaiId="@Context.Request.Query["loaiId"]"
           asp-route-phongId="@Context.Request.Query["phongId"]"
           asp-route-tinhTrang="@Context.Request.Query["tinhTrang"]"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm thiết bị mới</a>
        }
    </div>
</div>

<!-- Khung bộ lọc tìm kiếm hiện đại -->
<div class="filter-card">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Tìm mã, tên thiết bị..." />
            </div>
        </div>
        <div class="col-md-2">
            <select name="loaiId" asp-items="ViewBag.LoaiThietBiId" class="form-select">
                <option value="">-- Tất cả phân loại --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="phongId" asp-items="ViewBag.PhongId" class="form-select">
                <option value="">-- Tất cả phòng học --</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="tinhTrang" asp-items="ViewBag.TinhTrang" class="form-select">
                <option value="">-- Tất cả tình trạng --</option>
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc dữ liệu</button>
            <a asp-action="Index" class="btn btn-outline-dark" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 120px;">Mã TB</th>
                    <th>Tên thiết bị</th>
                    <th>Phân loại</th>
                    <th>Vị trí phòng</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-center">Tình trạng</th>
                    <th style="width: 110px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                            Không tìm thấy thiết bị nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="code-tag text-primary">@item.MaTb</span></td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenTb</div>
                                @if (!string.IsNullOrEmpty(item.HangSanXuat))
                                {
                                    <small class="text-muted">Hãng: @item.HangSanXuat @(item.NamSanXuat.HasValue ? $"({item.NamSanXuat})" : "")</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.LoaiThietBi.TenLoaiTB</span></td>
                            <td>
                                <a asp-controller="Phong" asp-action="Details" asp-route-id="@item.PhongId" class="text-decoration-none fw-semibold">
                                    <i class="bi bi-door-open text-muted me-1"></i>@item.Phong.TenPhong
                                </a>
                            </td>
                            <td class="text-center"><span class="badge bg-primary">@item.SoLuong @item.DonViTinh</span></td>
                            <td class="text-end fw-semibold text-secondary font-monospace">@(item.GiaMua?.ToString("N0") ?? "-") đ</td>
                            <td class="text-center">
                                @{
                                    var badgeColor = EnumHelper.BadgeTinhTrang(item.TinhTrang);
                                    var dotType = badgeColor == "success" ? "active" : (badgeColor == "danger" ? "danger" : "warning");
                                }
                                <span class="badge bg-@badgeColor">
                                    <span class="status-dot @dotType"></span>@EnumHelper.TenTinhTrang(item.TinhTrang)
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="table-actions justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết thiết bị">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />