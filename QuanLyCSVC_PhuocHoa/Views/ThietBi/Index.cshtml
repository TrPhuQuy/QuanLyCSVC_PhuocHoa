@model IEnumerable<ThietBi>
@{
    ViewData["Title"] = "Quản lý thiết bị";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-pc-display text-primary"></i> Danh sách thiết bị</h2>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel"
           asp-route-search="@ViewBag.Search"
           asp-route-loaiId="@Context.Request.Query["loaiId"]"
           asp-route-phongId="@Context.Request.Query["phongId"]"
           asp-route-tinhTrang="@Context.Request.Query["tinhTrang"]"
           class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
        </a>
        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm thiết bị</a>
        }
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã, tên thiết bị..." /></div>
    <div class="col-md-2"><select name="loaiId" asp-items="ViewBag.LoaiThietBiId" class="form-select"><option value="">-- Loại --</option></select></div>
    <div class="col-md-2"><select name="phongId" asp-items="ViewBag.PhongId" class="form-select"><option value="">-- Phòng --</option></select></div>
    <div class="col-md-2"><select name="tinhTrang" asp-items="ViewBag.TinhTrang" class="form-select"><option value="">-- Tình trạng --</option></select></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã TB</th>
                    <th>Tên thiết bị</th>
                    <th>Loại</th>
                    <th>Phòng</th>
                    <th>SL</th>
                    <th>Giá mua</th>
                    <th>Tình trạng</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.MaTb</strong></td>
                        <td>@item.TenTb</td>
                        <td>@item.LoaiThietBi.TenLoaiTB</td>
                        <td>@item.Phong.TenPhong</td>
                        <td>@item.SoLuong @item.DonViTinh</td>
                        <td>@(item.GiaMua?.ToString("N0") ?? "-") đ</td>
                        <td><span class="badge bg-@EnumHelper.BadgeTinhTrang(item.TinhTrang)">@EnumHelper.TenTinhTrang(item.TinhTrang)</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
    