@model IEnumerable<ThietBi>
@{
    Layout = null;
    var phong = ViewBag.Phong as Phong;
    var title = phong != null ? $"In tem thiết bị - {phong.TenPhong}" : "In tem thiết bị hàng loạt";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - THCS Phước Hòa</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=JetBrains+Mono:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --sticker-border: #1e293b;
        }

        body {
            background-color: #f1f5f9;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #0f172a;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }

        .action-bar {
            background: linear-gradient(135deg, #0b1329 0%, #172554 100%);
            color: #ffffff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            padding: 0.85rem 1.5rem;
        }

        .btn-toolbar-print {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.45rem 1.15rem;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.4);
            transition: all 0.2s ease;
        }

        .btn-toolbar-print:hover {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn-toolbar-secondary {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-weight: 500;
            font-size: 0.88rem;
            padding: 0.45rem 0.95rem;
            border-radius: 8px;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-toolbar-secondary:hover {
            background: rgba(255, 255, 255, 0.22);
            color: #ffffff;
        }

        .print-tip-box {
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(147, 197, 253, 0.3);
            border-radius: 8px;
            padding: 0.5rem 0.85rem;
            font-size: 0.82rem;
            color: #dbeafe;
            margin-top: 0.6rem;
        }

        .labels-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            padding: 24px;
            max-width: 920px;
            margin: 0 auto;
        }

        .sticker-card {
            background: #ffffff;
            border: 1.5px solid var(--sticker-border);
            border-radius: 8px;
            padding: 10px 14px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            page-break-inside: avoid;
            break-inside: avoid;
            min-height: 155px;
            position: relative;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        .sticker-header {
            border-bottom: 1.5px solid #0f172a;
            padding-bottom: 5px;
            margin-bottom: 8px;
            text-align: center;
        }

        .school-title {
            font-size: 10.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #1e3a8a;
            line-height: 1.2;
        }

        .sticker-title {
            font-size: 11.5px;
            font-weight: 800;
            color: #dc2626;
            margin-top: 1px;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .sticker-body {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sticker-info {
            flex: 1;
            font-size: 11.5px;
            line-height: 1.4;
            color: #1e293b;
        }

        .sticker-info strong {
            color: #475569;
            font-weight: 600;
        }

        .sticker-info .code-badge {
            background: #0f172a;
            color: #ffffff;
            padding: 2px 7px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 11px;
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: 0.5px;
            display: inline-block;
        }

        .sticker-qr {
            width: 78px;
            text-align: center;
            flex-shrink: 0;
        }

        .sticker-qr div {
            display: inline-block;
            background: #fff;
            padding: 3px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
        }

        .sticker-qr .qr-caption {
            font-size: 8.5px;
            font-weight: 700;
            color: #475569;
            margin-top: 3px;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .sticker-footer {
            border-top: 1px dashed #cbd5e1;
            margin-top: 8px;
            padding-top: 4px;
            text-align: center;
            font-size: 8.5px;
            color: #64748b;
            font-weight: 500;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background: #ffffff !important;
            }
            .labels-container {
                max-width: 100% !important;
                padding: 0 !important;
                gap: 10px !important;
            }
            .sticker-card {
                border: 1.5px solid #000000 !important;
                box-shadow: none !important;
            }
            @@page {
                size: A4 portrait;
                margin: 8mm;
            }
        }
    </style>
</head>
<body>

    <!-- Thanh thao tác trên cùng (Ẩn khi in) -->
    <div class="action-bar no-print">
        <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h5 class="mb-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-qr-code-scan text-primary"></i> In tem QR quản lý tài sản
                    @if (phong != null)
                    {
                        <span class="text-info"> - @phong.TenPhong</span>
                    }
                </h5>
                <small class="text-white-50">Tổng số: <strong>@Model.Count()</strong> tem tài sản sẵn sàng in decal dán</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" onclick="window.history.back()" class="btn-toolbar-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </button>
                <button type="button" onclick="window.print()" class="btn btn-toolbar-print">
                    <i class="bi bi-printer-fill me-1"></i> In ngay (Ctrl + P)
                </button>
            </div>
        </div>
        <div class="container-fluid">
            <div class="print-tip-box d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                <div>
                    <strong>Hướng dẫn in nhãn Decal A4:</strong> Trong hộp thoại in, chọn khổ giấy <strong>A4</strong>, Tỷ lệ (Scale): <strong>100%</strong> (Fit to printable area), lề (Margins): <strong>Tối thiểu (Minimum)</strong> và tích chọn <strong>Đồ họa nền (Background graphics)</strong>.
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="container py-5 text-center text-muted">
            <i class="bi bi-inbox display-3 text-secondary"></i>
            <h5 class="mt-3">Không có thiết bị nào phù hợp với bộ lọc hiện tại</h5>
            <button onclick="window.history.back()" class="btn btn-primary mt-2">Quay lại danh sách</button>
        </div>
    }
    else
    {
        <div class="labels-container">
            @foreach (var item in Model)
            {
                <div class="sticker-card">
                    <div class="sticker-header">
                        <div class="school-title">TRƯỜNG THCS PHƯỚC HÒA</div>
                        <div class="sticker-title">TEM QUẢN LÝ TÀI SẢN</div>
                    </div>
                    <div class="sticker-body">
                        <div class="sticker-info">
                            <div class="mb-1"><strong>Mã TB:</strong> <span class="code-badge">@item.MaTb</span></div>
                            <div class="mb-1 text-truncate" style="max-width: 250px;" title="@item.TenTb"><strong>Tên:</strong> <span class="fw-bold">@item.TenTb</span></div>
                            <div class="mb-1"><strong>Phòng:</strong> @(item.Phong?.TenPhong ?? "-")</div>
                            <div class="mb-1"><strong>Tổ BM:</strong> @(item.BoMon?.TenBoMon ?? "Chung")</div>
                            <div><strong>Năm SD:</strong> @(item.NamSanXuat?.ToString() ?? item.NgayMua?.Year.ToString() ?? DateTime.Now.Year.ToString())</div>
                        </div>
                        <div class="sticker-qr">
                            <div class="qr-item" data-url="@Url.Action("Details", "ThietBi", new { id = item.Id }, Context.Request.Scheme)"></div>
                            <div class="qr-caption">QUÉT MÃ QR</div>
                        </div>
                    </div>
                    <div class="sticker-footer">
                        CSVC THCS Phước Hòa &bull; Mã định danh số tài sản
                    </div>
                </div>
            }
        </div>
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const qrElements = document.querySelectorAll(".qr-item");
            qrElements.forEach(el => {
                const url = el.getAttribute("data-url");
                if (url) {
                    new QRCode(el, {
                        text: url,
                        width: 72,
                        height: 72,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.M
                    });
                }
            });
        });
    </script>
</body>
</html>
