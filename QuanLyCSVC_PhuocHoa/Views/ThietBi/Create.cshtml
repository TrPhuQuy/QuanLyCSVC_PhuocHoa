@model ThietBi
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm thiết bị" : "Sửa thiết bị";
    var isEdit = Model.Id > 0;
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (isEdit) { <input type="hidden" asp-for="Id" /> <input type="hidden" asp-for="HinhAnh" /> <input type="hidden" asp-for="CreatedAt" /> }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaTb" class="form-label">Mã thiết bị</label>
                    <input asp-for="MaTb" class="form-control" placeholder="TB-2025-001" />
                    <span asp-validation-for="MaTb" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="TenTb" class="form-label">Tên thiết bị</label>
                    <input asp-for="TenTb" class="form-control" />
                    <span asp-validation-for="TenTb" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="LoaiThietBiId" class="form-label">Loại thiết bị</label>
                    <select asp-for="LoaiThietBiId" class="form-select" asp-items="ViewBag.LoaiThietBiId"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="PhongId" class="form-label">Phòng quản lý</label>
                    <select asp-for="PhongId" class="form-select" asp-items="ViewBag.PhongId"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="TinhTrang" class="form-label">Tình trạng</label>
                    <select asp-for="TinhTrang" class="form-select" asp-items="new SelectList(ViewBag.TinhTrangs)"></select>
                    <span asp-validation-for="TinhTrang" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="HangSanXuat" class="form-label"></label>
                    <input asp-for="HangSanXuat" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NamSanXuat" class="form-label"></label>
                    <input asp-for="NamSanXuat" class="form-control" type="number" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NgayMua" class="form-label"></label>
                    <input asp-for="NgayMua" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="GiaMua" class="form-label"></label>
                    <input asp-for="GiaMua" class="form-control" type="number" step="1000" />
                </div>
                <div class="col-md-3">
                    <label asp-for="SoLuong" class="form-label"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="1" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DonViTinh" class="form-label"></label>
                    <input asp-for="DonViTinh" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ViTriSuDung" class="form-label"></label>
                    <input asp-for="ViTriSuDung" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Hình ảnh</label>
                    <input type="file" name="hinhAnh" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="@Model.HinhAnh" class="mt-2 rounded" style="max-height:80px" alt="Ảnh TB" />
                    }
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
