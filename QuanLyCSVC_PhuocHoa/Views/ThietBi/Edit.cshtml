@model ThietBi
@{
    ViewData["Title"] = "Sửa thiết bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-pencil-square text-warning"></i> Sửa thông tin thiết bị</h2>
        <p class="text-muted mb-0">Cập nhật thông tin thiết bị: <strong>@Model.TenTb</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="HinhAnh" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsDeleted" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaTb" class="form-label fw-semibold">Mã thiết bị *</label>
                    <input asp-for="MaTb" class="form-control" />
                    <span asp-validation-for="MaTb" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="TenTb" class="form-label fw-semibold">Tên thiết bị *</label>
                    <input asp-for="TenTb" class="form-control" />
                    <span asp-validation-for="TenTb" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="LoaiThietBiId" class="form-label fw-semibold">Loại thiết bị</label>
                    <select asp-for="LoaiThietBiId" class="form-select" asp-items="ViewBag.LoaiThietBiId">
                        <option value="">-- Chọn loại --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="PhongId" class="form-label fw-semibold">Phòng quản lý</label>
                    <select asp-for="PhongId" class="form-select" asp-items="ViewBag.PhongId">
                        <option value="">-- Chọn phòng --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="TinhTrang" class="form-label fw-semibold">Tình trạng *</label>
                    <select asp-for="TinhTrang" class="form-select" asp-items="new SelectList(ViewBag.TinhTrangs)"></select>
                    <span asp-validation-for="TinhTrang" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NhaCungCapId" class="form-label fw-semibold">Nhà cung cấp</label>
                    <select asp-for="NhaCungCapId" class="form-select" asp-items="ViewBag.NhaCungCapId">
                        <option value="">-- Không xác định --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="BoMonId" class="form-label fw-semibold">Bộ môn</label>
                    <select asp-for="BoMonId" class="form-select" asp-items="ViewBag.BoMonId">
                        <option value="">-- Không xác định --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="HangSanXuat" class="form-label fw-semibold"></label>
                    <input asp-for="HangSanXuat" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NamSanXuat" class="form-label fw-semibold"></label>
                    <input asp-for="NamSanXuat" class="form-control" type="number" />
                </div>
                <div class="col-md-3">
                    <label asp-for="NgayMua" class="form-label fw-semibold"></label>
                    <input asp-for="NgayMua" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="GiaMua" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="GiaMua" class="form-control" type="number" step="1000" />
                        <span class="input-group-text">đ</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="SoLuong" class="form-label fw-semibold"></label>
                    <input asp-for="SoLuong" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-3">
                    <label asp-for="DonViTinh" class="form-label fw-semibold"></label>
                    <input asp-for="DonViTinh" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ViTriSuDung" class="form-label fw-semibold"></label>
                    <input asp-for="ViTriSuDung" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Hình ảnh</label>
                    <input type="file" name="hinhAnh" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="@Model.HinhAnh" class="mt-2 rounded shadow-sm" style="max-height:80px" alt="Ảnh TB" />
                        <small class="d-block text-muted">Chọn file mới để thay ảnh</small>
                    }
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 border-top pt-3">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Cập nhật thiết bị</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Xem chi tiết</a>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
