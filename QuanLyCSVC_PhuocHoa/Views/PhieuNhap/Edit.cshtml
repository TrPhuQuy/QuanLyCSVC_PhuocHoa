@model PhieuNhap
@{
    ViewData["Title"] = "Cập nhật Phiếu nhập";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-box-seam text-primary"></i> @ViewData["Title"]</h2>
        <p class="text-muted mb-0">Cập nhật thông tin phiếu nhập: <strong>@Model.MaPhieuNhap</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MaPhieuNhap" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="TongTien" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Mã phiếu nhập</label>
                    <input class="form-control bg-light" value="@Model.MaPhieuNhap" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="NgayNhap" class="form-label fw-semibold">Ngày nhập *</label>
                    <input asp-for="NgayNhap" class="form-control" type="date" required />
                    <span asp-validation-for="NgayNhap" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NhaCungCapId" class="form-label fw-semibold">Nhà cung cấp *</label>
                    <select asp-for="NhaCungCapId" class="form-select" asp-items="ViewBag.NhaCungCapId">
                        <option value="">-- Chọn nhà cung cấp --</option>
                    </select>
                    <span asp-validation-for="NhaCungCapId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NguoiNhapId" class="form-label fw-semibold">Người nhập *</label>
                    <select asp-for="NguoiNhapId" class="form-select" asp-items="ViewBag.NguoiNhapId">
                        <option value="">-- Chọn người nhập --</option>
                    </select>
                    <span asp-validation-for="NguoiNhapId" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                    <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-3 bg-light p-3 rounded">
                <p class="mb-0 text-muted"><i class="bi bi-info-circle"></i> Để chỉnh sửa chi tiết thiết bị trong phiếu, vui lòng xem <a asp-action="Details" asp-route-id="@Model.Id">chi tiết phiếu nhập</a>.</p>
            </div>

            <div class="mt-4 border-top pt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu thay đổi</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Xem chi tiết</a>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
