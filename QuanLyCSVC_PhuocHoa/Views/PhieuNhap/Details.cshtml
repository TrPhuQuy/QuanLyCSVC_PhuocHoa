@model PhieuNhap
@{
    ViewData["Title"] = "Chi tiết Phiếu nhập";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-arrow-in-down text-success"></i> @Model.MaPhieuNhap</h2>
        <p class="text-muted mb-0">Ngày nhập: <strong>@Model.NgayNhap.ToString("dd/MM/yyyy")</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
        <a asp-action="PrintC30" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark">
            <i class="bi bi-printer"></i> In Phiếu nhập kho (C30-HD)
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3"><h5 class="mb-0 fw-semibold"><i class="bi bi-info-circle text-success"></i> Thông tin phiếu</h5></div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Nhà cung cấp:</span>
                        <span class="fw-bold">@Model.NhaCungCap?.TenNCC</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Người nhập:</span>
                        <span class="fw-semibold">@Model.NguoiNhap?.HoTen</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Ngày nhập:</span>
                        <span class="fw-semibold">@Model.NgayNhap.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Tổng tiền:</span>
                        <span class="fw-bold fs-5 text-success">@Model.TongTien.ToString("N0") đ</span>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                    {
                        <li class="list-group-item px-0">
                            <span class="text-muted">Ghi chú:</span>
                            <p class="mb-0 mt-1 text-secondary">@Model.GhiChu</p>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-list-ul text-success"></i> Chi tiết thiết bị nhập</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Thiết bị</th>
                            <th>Loại</th>
                            <th>Phòng</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietPhieuNhap)
                        {
                            <tr>
                                <td>
                                    <strong>@ct.ThietBi?.TenTb</strong>
                                    <small class="d-block text-muted">@ct.ThietBi?.MaTb</small>
                                </td>
                                <td class="text-muted">@ct.ThietBi?.LoaiThietBi?.TenLoaiTB</td>
                                <td class="text-muted">@ct.ThietBi?.Phong?.TenPhong</td>
                                <td class="text-center fw-bold">@ct.SoLuong @ct.ThietBi?.DonViTinh</td>
                                <td class="text-end">@ct.DonGia.ToString("N0") đ</td>
                                <td class="text-end fw-semibold text-success">@ct.ThanhTien.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">Tổng cộng:</td>
                            <td class="text-end fw-bold text-success fs-6">@Model.TongTien.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
