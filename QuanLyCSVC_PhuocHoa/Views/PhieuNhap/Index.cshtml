@model PaginatedList<PhieuNhap>
@{
    ViewData["Title"] = "Quản lý Phiếu nhập Thiết bị";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-box-arrow-in-down text-success"></i> Phiếu nhập Thiết bị</h2>
        <p class="text-muted mb-0">Ghi nhận các đợt nhập thiết bị từ nhà cung cấp</p>
    </div>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Tạo phiếu nhập</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã phiếu, nhà cung cấp..." /></div>
    <div class="col-md-2"><input type="date" name="from" value="@ViewBag.From" class="form-control" title="Từ ngày" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@ViewBag.To" class="form-control" title="Đến ngày" /></div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Ngày nhập</th>
                    <th>Người nhập</th>
                    <th>Số loại TB</th>
                    <th>Tổng tiền</th>
                    <th style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Không có phiếu nhập nào.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MaPhieuNhap</strong></td>
                            <td>@item.NhaCungCap?.TenNCC</td>
                            <td>@item.NgayNhap.ToString("dd/MM/yyyy")</td>
                            <td>@item.NguoiNhap?.HoTen</td>
                            <td><span class="badge bg-info text-dark">@item.ChiTietPhieuNhap.Count loại</span></td>
                            <td><strong class="text-success">@item.TongTien.ToString("N0") đ</strong></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            @if (Model.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="text-end fw-bold">Tổng tiền (trang này):</td>
                        <td class="fw-bold text-success">@Model.Sum(p => p.TongTien).ToString("N0") đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
