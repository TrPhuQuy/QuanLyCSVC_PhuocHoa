@using QuanLyCSVC_PhuocHoa.Models
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý CSVC THCS Phước Hòa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-main">
        <div class="container-fluid px-3 px-lg-4">
            <a class="brand-wrapper" asp-controller="Home" asp-action="Index">
                <div class="brand-logo-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <div class="brand-text-title">THCS PHƯỚC HÒA</div>
                    <div class="brand-text-sub">QUẢN LÝ CƠ SỞ VẬT CHẤT</div>
                </div>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto ps-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> <span>Tổng quan</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(new[] { "Phong", "LoaiPhong", "LoaiThietBi", "BoMon", "NhaCungCap" }.Contains(currentCtrl) ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-list-task"></i> <span>Danh mục</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item @(currentCtrl == "Phong" ? "active" : "")" asp-controller="Phong" asp-action="Index"><i class="bi bi-door-open me-2 text-primary"></i>Phòng học &amp; Khu chức năng</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "LoaiPhong" ? "active" : "")" asp-controller="LoaiPhong" asp-action="Index"><i class="bi bi-window-sidebar me-2 text-info"></i>Loại phòng</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "LoaiThietBi" ? "active" : "")" asp-controller="LoaiThietBi" asp-action="Index"><i class="bi bi-tags me-2 text-success"></i>Loại thiết bị</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "BoMon" ? "active" : "")" asp-controller="BoMon" asp-action="Index"><i class="bi bi-journal-bookmark me-2 text-warning"></i>Tổ bộ môn</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "NhaCungCap" ? "active" : "")" asp-controller="NhaCungCap" asp-action="Index"><i class="bi bi-truck me-2 text-secondary"></i>Nhà cung cấp</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "ThietBi" ? "active" : "")" asp-controller="ThietBi" asp-action="Index">
                                <i class="bi bi-pc-display"></i> <span>Thiết bị</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(new[] { "PhieuMuon", "DieuChuyen", "PhieuBaoTri", "PhieuNhap", "PhieuThanhLy", "DotKiemKe" }.Contains(currentCtrl) ? "active" : "")" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-gear-wide-connected"></i> <span>Nghiệp vụ</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item @(currentCtrl == "PhieuMuon" ? "active" : "")" asp-controller="PhieuMuon" asp-action="Index"><i class="bi bi-calendar-event me-2 text-primary"></i>Mượn trả thiết bị</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "DieuChuyen" ? "active" : "")" asp-controller="DieuChuyen" asp-action="Index"><i class="bi bi-arrow-left-right me-2 text-info"></i>Điều chuyển thiết bị</a></li>
                                <li><a class="dropdown-item @(currentCtrl == "PhieuBaoTri" && currentAct != "Create" ? "active" : "")" asp-controller="PhieuBaoTri" asp-action="Index"><i class="bi bi-tools me-2 text-warning"></i>Phiếu bảo trì - sửa chữa</a></li>
                                <li><a class="dropdown-item text-warning fw-semibold @(currentCtrl == "PhieuBaoTri" && currentAct == "Create" ? "active" : "")" asp-controller="PhieuBaoTri" asp-action="Create"><i class="bi bi-exclamation-triangle me-2"></i>Báo hỏng thiết bị</a></li>
                                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item @(currentCtrl == "PhieuNhap" ? "active" : "")" asp-controller="PhieuNhap" asp-action="Index"><i class="bi bi-box-seam me-2 text-success"></i>Nhập kho thiết bị (Mẫu C30-HD)</a></li>
                                    <li><a class="dropdown-item @(currentCtrl == "PhieuThanhLy" ? "active" : "")" asp-controller="PhieuThanhLy" asp-action="Index"><i class="bi bi-trash me-2 text-danger"></i>Thanh lý tài sản</a></li>
                                    <li><a class="dropdown-item @(currentCtrl == "DotKiemKe" ? "active" : "")" asp-controller="DotKiemKe" asp-action="Index"><i class="bi bi-clipboard-check me-2 text-primary"></i>Kiểm kê tài sản (Mẫu C53-HD)</a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "BaoCao" ? "active" : "")" asp-controller="BaoCao" asp-action="Index">
                                <i class="bi bi-file-earmark-bar-graph"></i> <span>Báo cáo</span>
                            </a>
                        </li>
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl == "NhanVien" ? "active" : "")" asp-controller="NhanVien" asp-action="Index">
                                    <i class="bi bi-people"></i> <span>Nhân viên</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentCtrl == "LichSuHoatDong" ? "active" : "")" asp-controller="LichSuHoatDong" asp-action="Index">
                                    <i class="bi bi-clock-history"></i> <span>Nhật ký</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <button type="button" class="btn btn-qr-scan" data-bs-toggle="modal" data-bs-target="#qrScannerModal" title="Quét mã QR thiết bị / phòng học">
                                <i class="bi bi-qr-code-scan"></i>
                                <span class="d-none d-xl-inline">Quét QR</span>
                            </button>
                        </li>
                        <vc:navbar-alerts></vc:navbar-alerts>
                        <li class="nav-item dropdown">
                            <a class="user-profile-badge dropdown-toggle text-decoration-none" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="user-avatar-circle">
                                    @(string.IsNullOrWhiteSpace(User.Identity?.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpper())
                                </span>
                                <span class="d-none d-md-inline text-truncate" style="max-width: 150px;">@User.Identity?.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg" style="min-width: 240px;">
                                <li class="px-3 py-2 border-bottom mb-1 bg-light rounded-top">
                                    <small class="text-muted d-block">Tài khoản đăng nhập</small>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 210px;">@User.Identity?.Name</div>
                                    @if (User.IsInRole(AppRoles.Admin))
                                    {
                                        <span class="badge bg-danger mt-1">Quản trị viên</span>
                                    }
                                    else if (User.IsInRole(AppRoles.NhanVienThietBi))
                                    {
                                        <span class="badge bg-primary mt-1">Cán bộ thiết bị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success mt-1">Giáo viên</span>
                                    }
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key me-2 text-primary"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4 px-3 px-lg-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div class="flex-grow-1 fw-medium">@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <div class="flex-grow-1 fw-medium">@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main">@RenderBody()</main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Modal Quét mã QR toàn hệ thống -->
        <div class="modal fade" id="qrScannerModal" tabindex="-1" aria-labelledby="qrScannerModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="modal-header bg-dark text-white py-3 border-0">
                        <h5 class="modal-title fs-6 fw-bold" id="qrScannerModalLabel">
                            <i class="bi bi-qr-code-scan me-2 text-primary"></i> Quét mã QR Thiết bị / Phòng học
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4 text-center">
                        <p class="text-muted small mb-3">Hướng camera vào mã QR trên tem dán thiết bị hoặc biển tên phòng học để tra cứu tự động.</p>
                        <div id="qr-reader" class="rounded-3 overflow-hidden shadow-sm mx-auto bg-light border" style="width: 100%; min-height: 240px;"></div>
                        <div id="qr-reader-results" class="mt-2 text-success fw-bold small"></div>

                        <div class="mt-3 pt-3 border-top text-start">
                            <label class="form-label small fw-semibold text-muted">Hoặc nhập trực tiếp Mã TB / Mã Phòng:</label>
                            <form method="get" asp-controller="ThietBi" asp-action="Scan" class="input-group">
                                <input type="text" name="code" class="form-control" placeholder="VD: TB001 hoặc P101..." required />
                                <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Tra cứu</button>
                            </form>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2 border-0">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <footer class="footer-main">
        <div class="container-fluid px-3 px-lg-4 footer-content">
            <div>
                <span class="fw-bold text-dark">Trường THCS Phước Hòa</span> &bull; Xã Phước Hòa, Huyện Phú Giáo, Tỉnh Bình Dương &bull; ĐT: (0274) 3.678.xxx
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary">v2.0 Enterprise</span>
                <span>&copy; 2025-2026 Hệ thống Quản lý Cơ sở vật chất THCS Phước Hòa</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        let html5QrCode = null;
        const scannerModal = document.getElementById('qrScannerModal');
        if (scannerModal) {
            scannerModal.addEventListener('shown.bs.modal', function () {
                if (!html5QrCode) {
                    html5QrCode = new Html5Qrcode("qr-reader");
                }
                html5QrCode.start(
                    { facingMode: "environment" },
                    { fps: 10, qrbox: { width: 220, height: 220 } },
                    (decodedText) => {
                        document.getElementById('qr-reader-results').innerText = "Đang chuyển đến: " + decodedText;
                        html5QrCode.stop().then(() => {
                            window.location.href = `/ThietBi/Scan?code=${encodeURIComponent(decodedText)}`;
                        }).catch(() => {
                            window.location.href = `/ThietBi/Scan?code=${encodeURIComponent(decodedText)}`;
                        });
                    },
                    (errorMessage) => {
                        // ignore parsing frames
                    }
                ).catch(err => {
                    document.getElementById('qr-reader').innerHTML = `
                        <div class="p-4 text-muted text-center">
                            <i class="bi bi-camera-video-off display-4 text-warning"></i>
                            <p class="mt-2 mb-1 fw-semibold">Không thể khởi động Camera</p>
                            <small>Vui lòng cấp quyền camera cho trình duyệt hoặc dùng ô nhập mã bên dưới.</small>
                        </div>`;
                });
            });

            scannerModal.addEventListener('hidden.bs.modal', function () {
                if (html5QrCode && html5QrCode.isScanning) {
                    html5QrCode.stop().catch(err => console.error(err));
                }
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
