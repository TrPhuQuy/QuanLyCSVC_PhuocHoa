@model NhaCungCap
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaNCC" class="form-label">Mã nhà cung cấp</label>
                    <input asp-for="MaNCC" class="form-control" placeholder="VD: NCC-001" />
                    <span asp-validation-for="MaNCC" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="TenNCC" class="form-label">Tên nhà cung cấp</label>
                    <input asp-for="TenNCC" class="form-control" placeholder="Tên công ty / Cửa hàng" />
                    <span asp-validation-for="TenNCC" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="NguoiDaiDien" class="form-label">Người đại diện</label>
                    <input asp-for="NguoiDaiDien" class="form-control" />
                    <span asp-validation-for="NguoiDaiDien" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaSoThue" class="form-label">Mã số thuế</label>
                    <input asp-for="MaSoThue" class="form-control" />
                    <span asp-validation-for="MaSoThue" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Sdt" class="form-label">Số điện thoại</label>
                    <input asp-for="Sdt" class="form-control" type="tel" />
                    <span asp-validation-for="Sdt" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                    <input asp-for="DiaChi" class="form-control" />
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-2">
                        <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                        <label asp-for="TrangThai" class="form-check-label">Hoạt động / Kích hoạt</label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
