@model PhieuBaoTri
@{
    Layout = null;
    var tb = Model.ThietBi;
    var ngayGui = Model.NgayGui;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biên bản sửa chữa thiết bị - @Model.MaBaoTri</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Times New Roman', Times, serif;
            color: #000000;
            margin: 0;
            padding: 0;
            font-size: 14.5px;
            line-height: 1.5;
        }

        .action-bar {
            background: #ffffff;
            border-bottom: 1px solid #cbd5e1;
            position: sticky;
            top: 0;
            z-index: 1000;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        }

        .print-page {
            background: #ffffff;
            max-width: 850px;
            margin: 20px auto;
            padding: 40px 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 1px solid #e2e8f0;
        }

        .table-bt {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .table-bt th, .table-bt td {
            border: 1px solid #000000;
            padding: 8px 10px;
            vertical-align: middle;
        }

        .table-bt th {
            text-align: center;
            font-weight: bold;
            background-color: #f8fafc;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background: #ffffff;
            }
            .print-page {
                box-shadow: none;
                border: none;
                margin: 0;
                padding: 0;
                max-width: 100%;
            }
            @@page {
                size: A4 portrait;
                margin: 15mm 15mm 15mm 20mm;
            }
        }
    </style>
</head>
<body>

    <div class="action-bar py-2 px-3 no-print d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-bold text-dark"><i class="bi bi-printer text-warning me-1"></i> In Giấy đề xuất &amp; Bàn giao sửa chữa</span>
            <span class="text-muted small ms-2">(@Model.MaBaoTri)</span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.history.back()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</button>
            <button onclick="window.print()" class="btn btn-warning btn-sm text-dark fw-bold"><i class="bi bi-printer-fill"></i> In phiếu sửa chữa (Ctrl + P)</button>
        </div>
    </div>

    <div class="print-page">
        <!-- Quốc hiệu & Tiêu ngữ -->
        <table style="width: 100%; border: none; margin-bottom: 20px;">
            <tr>
                <td style="width: 45%; text-align: center; vertical-align: top;">
                    <div style="font-size: 13px; text-transform: uppercase;">PHÒNG GD&ĐT HUYỆN PHÚ GIÁO</div>
                    <div style="font-size: 14px; font-weight: bold; text-transform: uppercase;">TRƯỜNG THCS PHƯỚC HÒA</div>
                    <div style="font-size: 13px; margin-top: 2px;">Mã phiếu: <strong>@Model.MaBaoTri</strong></div>
                </td>
                <td style="width: 55%; text-align: center; vertical-align: top;">
                    <div style="font-size: 14px; font-weight: bold; text-transform: uppercase;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                    <div style="font-size: 14px; font-weight: bold; text-decoration: underline;">Độc lập - Tự do - Hạnh phúc</div>
                    <div style="font-size: 13px; font-style: italic; margin-top: 5px;">
                        Phước Hòa, ngày @ngayGui.Day tháng @ngayGui.Month năm @ngayGui.Year
                    </div>
                </td>
            </tr>
        </table>

        <!-- Tiêu đề văn bản -->
        <div style="text-align: center; margin: 25px 0 20px 0;">
            <div style="font-size: 18px; font-weight: bold; text-transform: uppercase;">GIẤY ĐỀ NGHỊ VÀ BIÊN BẢN BÀN GIAO</div>
            <div style="font-size: 16px; font-weight: bold; text-transform: uppercase;">SỬA CHỮA, BẢO TRÌ THIẾT BỊ TRƯỜNG HỌC</div>
        </div>

        <p><strong>Kính gửi:</strong> Ban Giám hiệu Trường THCS Phước Hòa.</p>

        <!-- Thông tin đề nghị -->
        <div style="margin-bottom: 12px;">
            <p style="margin-bottom: 5px;">Họ và tên người đề xuất: <strong>@(Model.NguoiGui?.HoTen ?? "........................................")</strong> - Chức vụ: @(Model.NguoiGui?.ChucVu ?? "Giáo viên/Cán bộ")</p>
            <p style="margin-bottom: 5px;">Đơn vị / Tổ chuyên môn: <strong>@(Model.NguoiGui?.BoMon?.TenBoMon ?? "Trường THCS Phước Hòa")</strong></p>
            <p style="margin-bottom: 5px;">Kính đề nghị Ban Giám hiệu xem xét, phê duyệt cho sửa chữa/bảo trì thiết bị dạy học dưới đây:</p>
        </div>

        <!-- Bảng thiết bị -->
        <table class="table-bt">
            <thead>
                <tr>
                    <th style="width: 45px;">STT</th>
                    <th>Tên thiết bị / Model</th>
                    <th style="width: 95px;">Mã TB</th>
                    <th style="width: 65px;">ĐVT</th>
                    <th style="width: 140px;">Vị trí phòng học</th>
                    <th>Hiện trạng hỏng hóc</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="text-align: center;">1</td>
                    <td><strong>@(tb?.TenTb ?? "Thiết bị trường học")</strong></td>
                    <td style="text-align: center; font-family: monospace;">@(tb?.MaTb ?? "-")</td>
                    <td style="text-align: center;">@(tb?.DonViTinh ?? "Cái")</td>
                    <td style="text-align: center;">@(tb?.Phong?.TenPhong ?? "-")</td>
                    <td>@Model.NoiDungHongHoc</td>
                </tr>
            </tbody>
        </table>

        <!-- Kế hoạch & chi phí -->
        <div style="margin-top: 15px;">
            <p><strong>1. Đơn vị / Cơ sở sửa chữa dự kiến:</strong> @(string.IsNullOrWhiteSpace(Model.DonViSuaChua) ? "................................................................................" : Model.DonViSuaChua)</p>
            <p><strong>2. Kinh phí sửa chữa ước tính / thực tế:</strong> @(Model.ChiPhi.HasValue ? Model.ChiPhi.Value.ToString("N0") + " đ" : ".................................... đ")</p>
            <p><strong>3. Ngày gửi đi sửa:</strong> @Model.NgayGui.ToString("dd/MM/yyyy") - <strong>Ngày nhận lại dự kiến/thực tế:</strong> @(Model.NgayNhanLai?.ToString("dd/MM/yyyy") ?? "....................")</p>
            @if (!string.IsNullOrWhiteSpace(Model.KetQua))
            {
                <p><strong>4. Kết quả sau sửa chữa:</strong> @Model.KetQua</p>
            }
        </div>

        <p style="font-style: italic; margin-top: 15px;">Kính trình Ban Giám hiệu xem xét, phê duyệt kinh phí và chấp thuận sửa chữa để đảm bảo phục vụ kịp thời công tác dạy và học.</p>

        <!-- Chữ ký -->
        <table style="width: 100%; border: none; margin-top: 35px; text-align: center;">
            <tr>
                <td style="width: 33%; vertical-align: top;">
                    <div style="font-weight: bold; text-transform: uppercase;">NGƯỜI ĐỀ NGHỊ</div>
                    <div style="font-style: italic; font-size: 13px;">(Ký và ghi rõ họ tên)</div>
                    <div style="height: 75px;"></div>
                    <div style="font-weight: bold;">@(Model.NguoiGui?.HoTen ?? "")</div>
                </td>
                <td style="width: 33%; vertical-align: top;">
                    <div style="font-weight: bold; text-transform: uppercase;">ĐƠN VỊ SỬA CHỮA</div>
                    <div style="font-style: italic; font-size: 13px;">(Ký và ghi rõ họ tên/đóng dấu)</div>
                    <div style="height: 75px;"></div>
                    <div style="font-weight: bold;">@(Model.DonViSuaChua ?? "")</div>
                </td>
                <td style="width: 34%; vertical-align: top;">
                    <div style="font-weight: bold; text-transform: uppercase;">HIỆU TRƯỞNG DUYỆT</div>
                    <div style="font-style: italic; font-size: 13px;">(Ký và đóng dấu)</div>
                    <div style="height: 75px;"></div>
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
