@model PhieuBaoTri
@{
    ViewData["Title"] = "Ghi nhận Phiếu bảo trì";
    bool isStaff = ViewBag.IsStaff ?? false;
}
<h2 class="mb-4">@ViewData["Title"]</h2>
<div class="card shadow-sm col-md-8">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="MaBaoTri" />
            <input type="hidden" asp-for="TrangThai" />
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Mã phiếu bảo trì</label>
                    <input class="form-control" value="@Model.MaBaoTri" disabled />
                </div>
                <div class="col-md-8">
                    <label asp-for="ThietBiId" class="form-label">Thiết bị cần bảo trì *</label>
                    <select asp-for="ThietBiId" class="form-select" asp-items="ViewBag.ThietBiId">
                        <option value="">-- Chọn thiết bị --</option>
                    </select>
                    <span asp-validation-for="ThietBiId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NgayGui" class="form-label">Ngày gửi sửa *</label>
                    <input asp-for="NgayGui" class="form-control" type="date" required />
                    <span asp-validation-for="NgayGui" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="NoiDungHongHoc" class="form-label">Nội dung hỏng hóc *</label>
                    <textarea asp-for="NoiDungHongHoc" class="form-control" rows="3" placeholder="Mô tả chi tiết tình trạng hỏng hóc..." required></textarea>
                    <span asp-validation-for="NoiDungHongHoc" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DonViSuaChua" class="form-label">Đơn vị sửa chữa</label>
                    <input asp-for="DonViSuaChua" class="form-control" placeholder="Tên công ty / cơ sở sửa chữa..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Người gửi sửa *</label>
                    @if (isStaff)
                    {
                        <select asp-for="NguoiGuiId" class="form-select" asp-items="ViewBag.NguoiGuiId">
                            <option value="">-- Chọn người gửi --</option>
                        </select>
                        <span asp-validation-for="NguoiGuiId" class="text-danger"></span>
                    }
                    else
                    {
                        <input class="form-control" value="@ViewBag.CurrentEmployeeName" disabled />
                        <input type="hidden" asp-for="NguoiGuiId" />
                        <div class="form-text">Phiếu sẽ được ghi nhận với người gửi là chính bạn.</div>
                    }
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Ghi nhận phiếu bảo trì</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
