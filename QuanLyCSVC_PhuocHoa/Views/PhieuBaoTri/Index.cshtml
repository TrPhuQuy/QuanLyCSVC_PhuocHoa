@model PaginatedList<PhieuBaoTri>
@{
    ViewData["Title"] = "Quản lý Bảo trì Thiết bị";
}

<div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h2 class="d-flex align-items-center gap-2">
            <i class="bi bi-tools text-primary"></i>
            <span>Phiếu Bảo trì &amp; Sửa chữa Thiết bị</span>
            <span class="badge bg-primary fs-6 fw-bold">@Model.TotalItems</span>
        </h2>
        <p>Theo dõi tiến độ tiếp nhận báo hỏng, gửi đơn vị sửa chữa và nghiệm thu hoàn thành</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-warning text-dark fw-bold shadow-sm">
            <i class="bi bi-exclamation-triangle-fill"></i> Báo hỏng thiết bị mới
        </a>
    </div>
</div>

<div class="filter-card">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Mã phiếu, tên thiết bị, người gửi..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="trangThai" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                @foreach (var tt in ViewBag.TrangThais)
                {
                    <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@tt</option>
                }
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc dữ liệu</button>
            <a asp-action="Index" class="btn btn-outline-dark" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 120px;">Mã phiếu</th>
                    <th>Thiết bị</th>
                    <th>Nội dung hỏng hóc</th>
                    <th>Người báo</th>
                    <th>Ngày gửi</th>
                    <th>Ngày nhận lại</th>
                    <th class="text-end">Chi phí</th>
                    <th class="text-center">Trạng thái</th>
                    <th style="width: 100px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                            Không có phiếu bảo trì nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="code-tag text-primary">@item.MaBaoTri</span></td>
                            <td>
                                <div class="fw-bold text-dark">@item.ThietBi?.TenTb</div>
                                <small class="text-muted font-monospace">@item.ThietBi?.MaTb</small>
                            </td>
                            <td class="text-truncate" style="max-width: 220px;" title="@item.NoiDungHongHoc">@item.NoiDungHongHoc</td>
                            <td>@item.NguoiGui?.HoTen</td>
                            <td class="font-monospace">@item.NgayGui.ToString("dd/MM/yyyy")</td>
                            <td class="font-monospace">@(item.NgayNhanLai?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-end font-monospace fw-bold text-danger">@(item.ChiPhi?.ToString("N0") ?? "-") đ</td>
                            <td class="text-center">
                                @{
                                    var (badgeColor, dotType) = item.TrangThai switch
                                    {
                                        "Hoàn thành" => ("success", "active"),
                                        "Không sửa được" => ("danger", "danger"),
                                        _ => ("warning", "warning")
                                    };
                                }
                                <span class="badge bg-@badgeColor">
                                    <span class="status-dot @dotType"></span>@item.TrangThai
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="table-actions justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết phiếu">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Cập nhật tiến độ">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
