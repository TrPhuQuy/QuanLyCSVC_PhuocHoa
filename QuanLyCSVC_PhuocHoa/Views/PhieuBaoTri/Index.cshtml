@model IEnumerable<PhieuBaoTri>
@{
    ViewData["Title"] = "Quản lý Bảo trì Thiết bị";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-tools text-primary"></i> Phiếu Bảo trì Thiết bị</h2>
        <p class="text-muted mb-0">Theo dõi tình trạng gửi sửa chữa và bảo dưỡng thiết bị</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Báo hỏng / Ghi nhận bảo trì</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã phiếu, tên thiết bị, người gửi..." /></div>
    <div class="col-md-2">
        <select name="trangThai" class="form-select">
            <option value="">-- Trạng thái --</option>
            @foreach (var tt in ViewBag.TrangThais)
            {
                <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@tt</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button></div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Thiết bị</th>
                    <th>Nội dung hỏng</th>
                    <th>Người gửi</th>
                    <th>Ngày gửi</th>
                    <th>Ngày nhận lại</th>
                    <th>Chi phí</th>
                    <th>Trạng thái</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center py-4 text-muted">Không có phiếu bảo trì nào.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MaBaoTri</strong></td>
                            <td>
                                <div>@item.ThietBi?.TenTb</div>
                                <small class="text-muted">@item.ThietBi?.MaTb</small>
                            </td>
                            <td class="text-truncate" style="max-width:150px;">@item.NoiDungHongHoc</td>
                            <td>@item.NguoiGui?.HoTen</td>
                            <td>@item.NgayGui.ToString("dd/MM/yyyy")</td>
                            <td>@(item.NgayNhanLai?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.ChiPhi?.ToString("N0") ?? "-") đ</td>
                            <td>
                                @{
                                    var badge = item.TrangThai == "Hoàn thành" ? "success"
                                              : item.TrangThai == "Không sửa được" ? "danger" : "warning";
                                }
                                <span class="badge bg-@badge">@item.TrangThai</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
