@{
    ViewData["Title"] = "Từ chối truy cập (403)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6 text-center">
            <div class="card border-0 shadow-lg p-4 p-md-5 bg-white rounded-4">
                <div class="card-body">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger mb-4" style="width: 90px; height: 90px; box-shadow: 0 0 25px rgba(239, 68, 68, 0.2);">
                        <i class="bi bi-shield-lock-fill" style="font-size: 2.75rem;"></i>
                    </div>
                    <div class="mb-2">
                        <span class="badge bg-danger">Mã lỗi 403: Không có quyền truy cập</span>
                    </div>
                    <h3 class="text-dark fw-bold mb-2">Truy cập bị giới hạn</h3>
                    <p class="text-muted mb-4" style="font-size: 0.95rem; line-height: 1.6;">
                        Tài khoản <strong>@(User.Identity?.Name ?? "hiện tại")</strong> của bạn chưa được cấp phân quyền để thực hiện nghiệp vụ hoặc truy cập khu vực này. Vui lòng liên hệ Quản trị viên hệ thống để nâng cấp quyền hạn.
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a href="/" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-speedometer2 me-1"></i> Về bảng điều khiển
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger px-3 py-2">
                                <i class="bi bi-box-arrow-right me-1"></i> Đổi tài khoản khác
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="mt-4 text-muted small">
                Hệ thống Quản lý CSVC &bull; Trường THCS Phước Hòa
            </div>
        </div>
    </div>
</div>
