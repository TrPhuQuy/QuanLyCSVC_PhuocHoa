@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-5 bg-white">
                <div class="card-body">
                    <div class="text-danger mb-4">
                        <i class="bi bi-shield-lock display-1"></i>
                    </div>
                    <h2 class="text-dark fw-bold mb-3">Từ chối truy cập</h2>
                    <p class="text-muted fs-5 mb-4">
                        Tài khoản của bạn không được phân quyền để truy cập vào trang này. 
                        Vui lòng liên hệ với Quản trị viên nếu bạn nghĩ đây là một sự nhầm lẫn.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/" class="btn btn-primary btn-lg px-4"><i class="bi bi-house"></i> Về trang chủ</a>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary btn-lg px-4"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
