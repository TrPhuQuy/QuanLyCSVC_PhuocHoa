@model QuanLyCSVC_PhuocHoa.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-key text-primary"></i> Đổi mật khẩu</h2>
        <p class="text-muted mb-0">Thay đổi mật khẩu đăng nhập tài khoản của bạn</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại trang chủ</a>
</div>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="CurrentPassword" class="form-control" type="password" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="NewPassword" class="form-control" type="password" id="newPwd" />
                            <button type="button" class="btn btn-outline-secondary" id="toggleNewPwd" tabindex="-1">
                                <i class="bi bi-eye" id="eyeIconNew"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPwd" />
                            <button type="button" class="btn btn-outline-secondary" id="toggleConfirmPwd" tabindex="-1">
                                <i class="bi bi-eye" id="eyeIconConfirm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-check2-square"></i> Cập nhật mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setupToggle(buttonId, inputId, iconId) {
            document.getElementById(buttonId).addEventListener('click', function () {
                const pwd = document.getElementById(inputId);
                const icon = document.getElementById(iconId);
                if (pwd.type === 'password') {
                    pwd.type = 'text';
                    icon.className = 'bi bi-eye-slash';
                } else {
                    pwd.type = 'password';
                    icon.className = 'bi bi-eye';
                }
            });
        }
        
        setupToggle('toggleNewPwd', 'newPwd', 'eyeIconNew');
        setupToggle('toggleConfirmPwd', 'confirmPwd', 'eyeIconConfirm');
    </script>
}
