@model PaginatedList<DieuChuyen>
@{
    ViewData["Title"] = "Điều chuyển Thiết bị";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-arrow-left-right text-primary"></i> Phiếu điều chuyển thiết bị</h2>
        <p class="text-muted mb-0">Quản lý và luân chuyển tài sản giữa các phòng chức năng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Đăng ký điều chuyển</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã phiếu, tên thiết bị..." />
    </div>
    <div class="col-md-2">
        <select name="trangThai" class="form-select">
            <option value="">-- Trạng thái --</option>
            @foreach (var tt in ViewBag.TrangThais)
            {
                <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@tt</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Thiết bị</th>
                    <th>Phòng đi</th>
                    <th>Phòng đến</th>
                    <th>Số lượng</th>
                    <th>Người đề nghị</th>
                    <th>Ngày đề nghị</th>
                    <th>Trạng thái</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Không tìm thấy yêu cầu điều chuyển nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MaDieuChuyen</strong></td>
                            <td>
                                <div>@item.ThietBi?.TenTb</div>
                                <small class="text-muted">@item.ThietBi?.MaTb</small>
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@item.PhongDi?.TenPhong</span></td>
                            <td><span class="badge bg-primary-subtle text-primary">@item.PhongDen?.TenPhong</span></td>
                            <td><strong>@item.SoLuong</strong></td>
                            <td>@item.NguoiDeNghi?.HoTen</td>
                            <td>@item.NgayDeNghi.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-@EnumHelper.BadgeTrangThai(item.TrangThai)">@EnumHelper.TenTrangThai(item.TrangThai)</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
