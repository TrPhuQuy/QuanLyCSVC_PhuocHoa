@model PhieuThanhLy
@{
    ViewData["Title"] = "Chi tiết Phiếu thanh lý";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-file-earmark-x text-danger"></i> @Model.MaThanhLy</h2>
        <p class="text-muted mb-0">Ngày đề nghị: <strong>@Model.NgayDeNghi.ToString("dd/MM/yyyy")</strong></p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3"><h5 class="mb-0 fw-semibold"><i class="bi bi-info-circle text-danger"></i> Thông tin phiếu</h5></div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Thiết bị:</span>
                        <span class="fw-bold">@Model.ThietBi?.TenTb</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Mã thiết bị:</span>
                        <span class="fw-semibold">@Model.ThietBi?.MaTb</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phòng:</span>
                        <span>@Model.ThietBi?.Phong?.TenPhong</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Giá trị còn lại:</span>
                        <span class="fw-bold text-danger">@(Model.GiaTriConLai?.ToString("N0") ?? "0") đ</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Trạng thái:</span>
                        @{
                            var badgeColor = Model.TrangThai == "Đã duyệt" ? "success"
                                           : Model.TrangThai == "Đã hủy" ? "secondary" : "warning";
                        }
                        <span class="badge bg-@badgeColor fs-6">@Model.TrangThai</span>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Model.SoQuyetDinh))
                    {
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Số quyết định:</span>
                            <span class="fw-semibold text-success">@Model.SoQuyetDinh</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-muted">Ngày quyết định:</span>
                            <span class="fw-semibold">@Model.NgayQuyetDinh?.ToString("dd/MM/yyyy")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @if (Model.TrangThai == "Đề nghị" && User.IsInRole(AppRoles.Admin))
        {
            <div class="card shadow-sm border-0 mt-3">
                <div class="card-header bg-success-subtle py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-shield-check"></i> Duyệt thanh lý</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận duyệt thanh lý? Thiết bị sẽ bị loại khỏi hệ thống!');">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số quyết định thanh lý *</label>
                            <input name="soQuyetDinh" class="form-control" placeholder="VD: QĐ-12/2025/THCS-PH" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Xác nhận duyệt thanh lý
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3"><h5 class="mb-0 fw-semibold"><i class="bi bi-chat-left-text text-danger"></i> Lý do thanh lý</h5></div>
            <div class="card-body bg-light"><p class="mb-0" style="white-space:pre-wrap;">@Model.LyDo</p></div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3"><h5 class="mb-0 fw-semibold"><i class="bi bi-people"></i> Hội đồng thanh lý</h5></div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Nhân viên</th><th>Bộ môn</th><th>Vai trò</th></tr>
                    </thead>
                    <tbody>
                        @if (!Model.ThanhVienHoiDong.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Chưa có thành viên hội đồng</td></tr>
                        }
                        @foreach (var tv in Model.ThanhVienHoiDong)
                        {
                            <tr>
                                <td><strong>@tv.NhanVien?.HoTen</strong></td>
                                <td class="text-muted">@tv.NhanVien?.ChucVu</td>
                                <td><span class="badge bg-primary">@tv.VaiTro</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
