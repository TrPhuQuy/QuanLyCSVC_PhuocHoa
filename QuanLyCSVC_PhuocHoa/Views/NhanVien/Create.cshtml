@model NhanVien
@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row g-3">
                <h5 class="border-bottom pb-2 text-primary"><i class="bi bi-person-fill"></i> Thông tin cá nhân</h5>
                
                <div class="col-md-3">
                    <label asp-for="MaNv" class="form-label">Mã nhân viên *</label>
                    <input asp-for="MaNv" class="form-control" placeholder="VD: GV001" required />
                    <span asp-validation-for="MaNv" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="HoTen" class="form-label">Họ và tên *</label>
                    <input asp-for="HoTen" class="form-control" required />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="true">Nam</option>
                        <option value="false">Nữ</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                    <input asp-for="NgaySinh" class="form-control" type="date" />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ChucVu" class="form-label">Chức vụ *</label>
                    <input asp-for="ChucVu" class="form-control" placeholder="VD: Giáo viên, Nhân viên thiết bị, Hiệu trưởng..." required />
                    <span asp-validation-for="ChucVu" class="text-danger"></span>
                    <small class="text-muted">Hệ thống phân quyền dựa trên chức vụ: Hiệu trưởng (Admin), Thiết bị/Kế toán (Nhân viên thiết bị), Khác (Giáo viên).</small>
                </div>
                <div class="col-md-4">
                    <label asp-for="BoMonId" class="form-label">Tổ bộ môn</label>
                    <select asp-for="BoMonId" class="form-select" asp-items="ViewBag.BoMonId">
                        <option value="">-- Chọn tổ bộ môn --</option>
                    </select>
                    <span asp-validation-for="BoMonId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Sdt" class="form-label">Số điện thoại</label>
                    <input asp-for="Sdt" class="form-control" type="tel" />
                    <span asp-validation-for="Sdt" class="text-danger"></span>
                </div>

                <h5 class="border-bottom pb-2 pt-3 text-primary"><i class="bi bi-shield-lock-fill"></i> Thông tin tài khoản đăng nhập</h5>
                
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email đăng nhập *</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="VD: gv001@phuochoa.edu.vn" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mật khẩu khởi tạo *</label>
                    <input name="password" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
                    <span class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check mt-3">
                        <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                        <label asp-for="TrangThai" class="form-check-label">Kích hoạt tài khoản / Đang làm việc</label>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Lưu nhân viên</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
