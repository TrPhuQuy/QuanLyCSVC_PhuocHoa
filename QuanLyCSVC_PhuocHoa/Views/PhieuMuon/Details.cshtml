@model PhieuMuon
@{
    ViewData["Title"] = "Chi tiết Phiếu mượn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-clock-history text-primary"></i> Phiếu mượn: @Model.MaPhieuMuon</h2>
        <p class="text-muted mb-0">Ngày đăng ký: <strong>@Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</strong></p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-info-circle text-primary"></i> Thông tin phiếu</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge bg-@EnumHelper.BadgeTrangThai(Model.TrangThai) fs-6">@EnumHelper.TenTrangThai(Model.TrangThai)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Giáo viên mượn:</span>
                        <span class="fw-semibold">@Model.GiaoVien?.HoTen</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Ngày mượn dự kiến:</span>
                        <span class="fw-semibold">@Model.NgayMuonDuKien.ToString("dd/MM/yyyy")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Ngày trả dự kiến:</span>
                        <span class="fw-semibold">@Model.NgayTraDuKien.ToString("dd/MM/yyyy")</span>
                    </li>
                    @if (Model.NgayMuonThucTe.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Ngày bàn giao thực tế:</span>
                            <span class="fw-semibold text-success">@Model.NgayMuonThucTe.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    }
                    @if (Model.NgayTraThucTe.HasValue)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Ngày trả thực tế:</span>
                            <span class="fw-semibold text-primary">@Model.NgayTraThucTe.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    }
                    @if (Model.NguoiDuyet != null)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-muted">Người duyệt:</span>
                            <span class="fw-semibold text-success">@Model.NguoiDuyet?.HoTen</span>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                    {
                        <li class="list-group-item px-0">
                            <span class="text-muted d-block">Ghi chú:</span>
                            <span class="text-secondary">@Model.GhiChu</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @if (Model.TrangThai == "Chờ duyệt" && (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi)))
        {
            <div class="card shadow-sm border-0 border-top-0">
                <div class="card-header bg-warning-subtle py-3">
                    <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-shield-check"></i> Phê duyệt</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Duyệt phiếu mượn và bàn giao thiết bị ngay bây giờ?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle"></i> Duyệt cho mượn</button>
                    </form>
                    <button class="btn btn-outline-danger" type="button" data-bs-toggle="collapse" data-bs-target="#rejectForm">
                        <i class="bi bi-x-circle"></i> Từ chối
                    </button>
                    <div class="collapse" id="rejectForm">
                        <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="card card-body bg-light mt-2">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Lý do từ chối:</label>
                                <input name="lyDo" class="form-control form-control-sm" placeholder="Nhập lý do..." required />
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Xác nhận từ chối</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        <form asp-action="Return" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark"><i class="bi bi-pc-display text-primary"></i> Danh sách thiết bị trong phiếu</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thiết bị</th>
                                <th>Phòng</th>
                                <th>SL mượn</th>
                                @if (Model.TrangThai == "Đang mượn" && (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi)))
                                {
                                    <th>Tình trạng khi trả</th>
                                    <th>Ghi chú khi trả</th>
                                }
                                else
                                {
                                    <th>Tình trạng khi trả</th>
                                    <th>Ghi chú</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TrangThai == "Đang mượn" && (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi)))
                            {
                                @foreach (var ct in Model.ChiTietPhieuMuon)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" name="ctIds" value="@ct.Id" />
                                            <strong>@ct.ThietBi?.TenTb</strong>
                                            <small class="d-block text-muted">@ct.ThietBi?.MaTb</small>
                                        </td>
                                        <td>@ct.ThietBi?.Phong?.TenPhong</td>
                                        <td><strong>@ct.SoLuongMuon</strong> @ct.ThietBi?.DonViTinh</td>
                                        <td>
                                            <select name="tinhTrangs" class="form-select form-select-sm">
                                                <option value="Tốt">Tốt</option>
                                                <option value="Hư hỏng">Hư hỏng</option>
                                                <option value="Mất">Mất</option>
                                            </select>
                                        </td>
                                        <td><input name="ghiChus" class="form-control form-control-sm" placeholder="Ghi chú..." /></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                @foreach (var ct in Model.ChiTietPhieuMuon)
                                {
                                    <tr>
                                        <td>
                                            <strong>@ct.ThietBi?.TenTb</strong>
                                            <small class="d-block text-muted">@ct.ThietBi?.MaTb</small>
                                        </td>
                                        <td>@ct.ThietBi?.Phong?.TenPhong</td>
                                        <td><strong>@ct.SoLuongMuon</strong> @ct.ThietBi?.DonViTinh</td>
                                        <td>@(ct.TinhTrangKhiTra ?? "-")</td>
                                        <td class="text-muted">@(ct.GhiChu ?? "-")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TrangThai == "Đang mượn" && (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.NhanVienThietBi)))
                {
                    <div class="card-footer bg-white border-top py-3">
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Xác nhận đã nhận lại thiết bị?');">
                            <i class="bi bi-box-arrow-in-left"></i> Ghi nhận trả thiết bị
                        </button>
                    </div>
                }
            </div>
        </form>
    </div>
</div>
