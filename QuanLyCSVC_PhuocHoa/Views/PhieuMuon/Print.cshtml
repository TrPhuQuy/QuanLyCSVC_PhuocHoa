@model PhieuMuon
@{
    Layout = null;
    var gv = Model.GiaoVien;
    var ngayMuon = Model.NgayMuonThucTe ?? Model.NgayDangKy;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu mượn thiết bị - @Model.MaPhieuMuon</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Times New Roman', Times, serif;
            color: #000000;
            margin: 0;
            padding: 0;
            font-size: 14.5px;
            line-height: 1.5;
        }

        .action-bar {
            background: #ffffff;
            border-bottom: 1px solid #cbd5e1;
            position: sticky;
            top: 0;
            z-index: 1000;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            box-shadow: 0 2px 5px rgba(0,0,0,0.08);
        }

        .print-page {
            background: #ffffff;
            max-width: 850px;
            margin: 20px auto;
            padding: 40px 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 1px solid #e2e8f0;
        }

        .table-pm {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .table-pm th, .table-pm td {
            border: 1px solid #000000;
            padding: 8px 10px;
            vertical-align: middle;
        }

        .table-pm th {
            text-align: center;
            font-weight: bold;
            background-color: #f8fafc;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                background: #ffffff;
            }
            .print-page {
                box-shadow: none;
                border: none;
                margin: 0;
                padding: 0;
                max-width: 100%;
            }
            @@page {
                size: A4 portrait;
                margin: 15mm 15mm 15mm 20mm;
            }
        }
    </style>
</head>
<body>

    <div class="action-bar py-2 px-3 no-print d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-bold text-dark"><i class="bi bi-printer text-primary me-1"></i> In Phiếu mượn - trả thiết bị dạy học</span>
            <span class="text-muted small ms-2">(@Model.MaPhieuMuon)</span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.history.back()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</button>
            <button onclick="window.print()" class="btn btn-primary btn-sm"><i class="bi bi-printer-fill"></i> In phiếu mượn (Ctrl + P)</button>
        </div>
    </div>

    <div class="print-page">
        <!-- Quốc hiệu & Tiêu ngữ -->
        <table style="width: 100%; border: none; margin-bottom: 20px;">
            <tr>
                <td style="width: 45%; text-align: center; vertical-align: top;">
                    <div style="font-size: 13px; text-transform: uppercase;">PHÒNG GD&ĐT HUYỆN PHÚ GIÁO</div>
                    <div style="font-size: 14px; font-weight: bold; text-transform: uppercase;">TRƯỜNG THCS PHƯỚC HÒA</div>
                    <div style="font-size: 13px; margin-top: 2px;">Mã phiếu: <strong>@Model.MaPhieuMuon</strong></div>
                </td>
                <td style="width: 55%; text-align: center; vertical-align: top;">
                    <div style="font-size: 14px; font-weight: bold; text-transform: uppercase;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                    <div style="font-size: 14px; font-weight: bold; text-decoration: underline;">Độc lập - Tự do - Hạnh phúc</div>
                    <div style="font-size: 13px; font-style: italic; margin-top: 5px;">
                        Phước Hòa, ngày @ngayMuon.Day tháng @ngayMuon.Month năm @ngayMuon.Year
                    </div>
                </td>
            </tr>
        </table>

        <!-- Tiêu đề văn bản -->
        <div style="text-align: center; margin: 25px 0 20px 0;">
            <div style="font-size: 18px; font-weight: bold; text-transform: uppercase;">PHIẾU THEO DÕI MƯỢN - TRẢ THIẾT BỊ DẠY HỌC</div>
            <div style="font-size: 13px; font-style: italic;">(Ban hành kèm theo Quy chế Quản lý & Sử dụng CSVC trường THCS Phước Hòa)</div>
        </div>

        <!-- Thông tin giáo viên & mượn -->
        <table style="width: 100%; border: none; margin-bottom: 12px; font-size: 14.5px;">
            <tr>
                <td style="width: 60%; padding: 3px 0;"><strong>Họ và tên giáo viên mượn:</strong> @(gv?.HoTen ?? "........................................")</td>
                <td style="width: 40%; padding: 3px 0;"><strong>Tổ bộ môn:</strong> @(gv?.BoMon?.TenBoMon ?? "....................")</td>
            </tr>
            <tr>
                <td style="padding: 3px 0;"><strong>Ngày mượn dự kiến:</strong> @Model.NgayMuonDuKien.ToString("dd/MM/yyyy")</td>
                <td style="padding: 3px 0;"><strong>Ngày trả dự kiến:</strong> @Model.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
            </tr>
            @if (Model.NgayMuonThucTe.HasValue)
            {
                <tr>
                    <td style="padding: 3px 0;"><strong>Thời gian bàn giao mượn:</strong> @Model.NgayMuonThucTe.Value.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="padding: 3px 0;"><strong>Cán bộ giao:</strong> @(Model.NguoiDuyet?.HoTen ?? "Cán bộ thiết bị")</td>
                </tr>
            }
            @if (Model.NgayTraThucTe.HasValue)
            {
                <tr>
                    <td style="padding: 3px 0;" colspan="2"><strong>Thời gian hoàn trả thực tế:</strong> @Model.NgayTraThucTe.Value.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
            @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
            {
                <tr>
                    <td style="padding: 3px 0;" colspan="2"><strong>Mục đích sử dụng:</strong> @Model.GhiChu</td>
                </tr>
            }
        </table>

        <!-- Danh sách thiết bị -->
        <div style="font-weight: bold; margin-top: 15px;">DANH SÁCH THIẾT BỊ, ĐỒ DÙNG DẠY HỌC BÀN GIAO:</div>
        <table class="table-pm" style="margin-top: 8px;">
            <thead>
                <tr>
                    <th style="width: 45px;">STT</th>
                    <th>Tên thiết bị / Đồ dùng</th>
                    <th style="width: 90px;">Mã TB</th>
                    <th style="width: 65px;">ĐVT</th>
                    <th style="width: 55px;">SL</th>
                    <th style="width: 120px;">Tình trạng khi mượn</th>
                    <th style="width: 120px;">Tình trạng khi trả</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var ct in Model.ChiTietPhieuMuon)
                {
                    <tr>
                        <td style="text-align: center;">@(stt++)</td>
                        <td><strong>@ct.ThietBi?.TenTb</strong></td>
                        <td style="text-align: center; font-family: monospace;">@ct.ThietBi?.MaTb</td>
                        <td style="text-align: center;">@(ct.ThietBi?.DonViTinh ?? "Cái")</td>
                        <td style="text-align: center; font-weight: bold;">@ct.SoLuongMuon</td>
                        <td style="text-align: center;">Hoạt động tốt</td>
                        <td style="text-align: center;">@(string.IsNullOrWhiteSpace(ct.TinhTrangKhiTra) || ct.TinhTrangKhiTra == "Đang mượn" ? "........................" : ct.TinhTrangKhiTra)</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Cam kết -->
        <div style="margin-top: 15px; font-style: italic; font-size: 13.5px;">
            * Giáo viên mượn có trách nhiệm bảo quản cẩn thận, sử dụng đúng hướng dẫn kỹ thuật và hoàn trả thiết bị đầy đủ, đúng hạn. Trường hợp làm mất mát, hư hỏng do lỗi chủ quan sẽ phải bồi hoàn theo quy định của nhà trường.
        </div>

        <!-- Chữ ký 2 bên: Lúc mượn và Lúc trả -->
        <div style="font-weight: bold; margin-top: 25px; text-transform: uppercase;">XÁC NHẬN BÀN GIAO KHI MƯỢN VÀ TRẢ THIẾT BỊ:</div>
        <table style="width: 100%; border: none; margin-top: 15px; text-align: center;">
            <tr>
                <td style="width: 50%; vertical-align: top;">
                    <div style="font-weight: bold; text-transform: uppercase;">CÁN BỘ PHỤ TRÁCH THIẾT BỊ</div>
                    <div style="font-style: italic; font-size: 13px;">(Ký và ghi rõ họ tên khi giao &amp; nhận lại)</div>
                    <div style="height: 75px;"></div>
                    <div style="font-weight: bold;">@(Model.NguoiDuyet?.HoTen ?? "")</div>
                </td>
                <td style="width: 50%; vertical-align: top;">
                    <div style="font-weight: bold; text-transform: uppercase;">GIÁO VIÊN MƯỢN THIẾT BỊ</div>
                    <div style="font-style: italic; font-size: 13px;">(Ký và ghi rõ họ tên khi nhận &amp; trả thiết bị)</div>
                    <div style="height: 75px;"></div>
                    <div style="font-weight: bold;">@(gv?.HoTen ?? "")</div>
                </td>
            </tr>
        </table>
    </div>

</body>
</html>
