@model IEnumerable<PhieuMuon>
@{
    ViewData["Title"] = "Mượn trả Thiết bị";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-clock-history text-primary"></i> Đăng ký Mượn trả Thiết bị</h2>
        <p class="text-muted mb-0">Quản lý việc mượn sử dụng thiết bị dạy học của giáo viên</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Đăng ký mượn thiết bị</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Mã phiếu, tên giáo viên..." />
    </div>
    <div class="col-md-2">
        <select name="trangThai" class="form-select">
            <option value="">-- Trạng thái --</option>
            @foreach (var tt in ViewBag.TrangThais)
            {
                <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@tt</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Giáo viên mượn</th>
                    <th>Ngày đăng ký</th>
                    <th>Ngày mượn dự kiến</th>
                    <th>Ngày trả dự kiến</th>
                    <th>Ngày trả thực tế</th>
                    <th>Trạng thái</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy phiếu mượn nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.MaPhieuMuon</strong></td>
                            <td>@item.GiaoVien?.HoTen</td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayMuonDuKien.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayTraDuKien.ToString("dd/MM/yyyy")</td>
                            <td>@(item.NgayTraThucTe?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <span class="badge bg-@EnumHelper.BadgeTrangThai(item.TrangThai)">@EnumHelper.TenTrangThai(item.TrangThai)</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
